# ---- Servidor (Vercel e .env.local). Nunca commitar valores reais. ----
# Banco Neon (Postgres)
DATABASE_URL=
# Texto aleatório longo, usado para assinar as sessões
SESSION_SECRET=
# Omie (Portal do desenvolvedor > Chave de integração)
OMIE_APP_KEY=
OMIE_APP_SECRET=
# Nexaas OMS
NEXAAS_API_TOKEN=
# URL base da API do Nexaas (sem barra no final). Ver README.
NEXAAS_API_URL=
# E-mail de credenciais
RESEND_API_KEY=

# Só para o script de migração (npm run migrar)
SUPABASE_DB_URL=
NEON_DB_URL=
# Organização dona dos produtos criados no Nexaas (opcional; padrão 475 = Center Norte)
NEXAAS_ORGANIZATION_ID=

# ClickUp (solicitações de código). Token: de um usuário "robô" com acesso só à lista monitorada.
CLICKUP_API_TOKEN=
# Segredo devolvido pelo ClickUp ao criar o webhook (confere a assinatura dos eventos)
CLICKUP_WEBHOOK_SECRET=
# Lista monitorada (padrão 901107247151 = Biscoitech > Painel > Tarefas Gerais)
CLICKUP_LIST_IDS=
# ID do usuário robô no ClickUp: eventos feitos por ele são ignorados (evita loop)
CLICKUP_BOT_USER_ID=
# 1 = comentar nas tarefas do ClickUp (desligado por padrão)
CLICKUP_COMENTAR=
# Setores que veem a tela Solicitações (padrão TI), separados por vírgula
SOLICITACOES_SETORES=
# Segredo do agendador externo que chama /api/clickup-conferir
CRON_SECRET=
CLICKUP_WEBHOOK_SECRET_2=
