# ---- Servidor (Vercel e .env.local). Nunca commitar valores reais. ----
# Banco Neon (Postgres)
DATABASE_URL=
# Texto aleatório longo, usado para assinar as sessões
SESSION_SECRET=
# Omie (Portal do desenvolvedor > Chave de integração)
OMIE_APP_KEY=
OMIE_APP_SECRET=
# Nexaas OMS
NEXAAS_API_TOKEN=
# URL base da API do Nexaas (sem barra no final). Ver README.
NEXAAS_API_URL=
# E-mail de credenciais
RESEND_API_KEY=

# Só para o script de migração (npm run migrar)
SUPABASE_DB_URL=
NEON_DB_URL=
